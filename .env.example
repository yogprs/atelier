# API used by the chat REST and WebSocket clients. The host root and the
# host/api form are both accepted; /api is added when it is missing.
VITE_API_BASE_URL=http://localhost:3000

# Optional origin for OAuth and refresh endpoints. Defaults to
# VITE_API_BASE_URL without its trailing /api segment.
# VITE_API_ORIGIN=http://localhost:3000

# Production API (usable from local for email login, chat, and uploads):
# VITE_API_BASE_URL=https://madgo.my.id
# VITE_API_ORIGIN=https://madgo.my.id

# Production frontend atelier.web.id with the API at madgo.my.id:
# VITE_API_BASE_URL=https://madgo.my.id
# VITE_API_ORIGIN=https://madgo.my.id

# Local go-chat example (the OAuth consoles in the screenshots use 8099):
# VITE_API_BASE_URL=http://localhost:8099
# VITE_API_ORIGIN=http://localhost:8099

VITE_DEFAULT_TIMEOUT=15000
